DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
GNANI_API_KEY=replace_with_gnani_key
GEMINI_API_KEY=replace_with_gemini_key
# Optional: GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.example.com
MAX_UPLOAD_SIZE_BYTES=2147483648
# S3-compatible private bucket (required for deployment / audio over 10 MB)
# Fill these values before starting production; unset AUDIO_BUCKET for local-only use.
# AUDIO_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=replace_with_bucket_access_key
# AWS_SECRET_ACCESS_KEY=replace_with_bucket_secret
# AWS_REGION=auto
