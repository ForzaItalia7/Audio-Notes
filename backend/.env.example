DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
GNANI_API_KEY=replace_with_gnani_key
GEMINI_API_KEY=replace_with_gemini_key
# Optional: GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGINS=http://localhost:3000,https://your-app.example.com
MAX_UPLOAD_SIZE_BYTES=2147483648
# Private Amazon S3 bucket (required for deployment / audio over 10 MB)
# Keep S3 Block Public Access enabled. Scope the IAM key to this bucket only.
# AUDIO_BUCKET=your-globally-unique-bucket-name
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# AWS_ACCESS_KEY_ID=replace_with_iam_access_key_id
# AWS_SECRET_ACCESS_KEY=replace_with_iam_secret_access_key
# AWS_REGION=ap-south-1
